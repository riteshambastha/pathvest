# ============================================
# Pathvest Backend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# ---------------------------------------------
# Database Configuration
# ---------------------------------------------
DATABASE_URL=postgresql://username:password@localhost:5432/pathvest

# ---------------------------------------------
# API Keys
# ---------------------------------------------
# AlphaVantage (for market data)
ALPHA_VANTAGE_API_KEY=your_alphavantage_api_key_here

# SEC API (for Form 4 and filing data)
SEC_API_KEY=your_sec_api_key_here

# OpenFIGI (for CUSIP to ticker mapping)
OPENFIGI_API_KEY=your_openfigi_api_key_here

# ---------------------------------------------
# Google Cloud Platform (Optional - for BigQuery)
# ---------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/gcp-credentials.json

# ---------------------------------------------
# Application Settings
# ---------------------------------------------
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------
# CORS Settings
# ---------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------
# Server Configuration
# ---------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------
# LEAN Engine (Optional)
# ---------------------------------------------
LEAN_ENGINE_PATH=/path/to/lean/engine
LEAN_DATA_PATH=/path/to/lean/data

# ---------------------------------------------
# Rate Limiting
# ---------------------------------------------
RATE_LIMIT_ENABLED=True
MAX_REQUESTS_PER_MINUTE=60

# ---------------------------------------------
# Logging
# ---------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=backend.log
