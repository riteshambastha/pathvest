# ==============================================
# PATHVEST STAGING ENVIRONMENT
# Use this on your localhost for testing
# ==============================================

# Application
APP_NAME=Pathvest API
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=staging

# Security
SECRET_KEY=staging-secret-key-change-in-production-abc123

# Database (local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pathvest

# CORS Origins (localhost ports)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:5173","http://127.0.0.1:5173"]

# External APIs
SEC_API_KEY=47d09b04f375b7573f5d34ee02326a9e9e5a3bd984d53f8eba4dcc90d3a5e266
ALPHAVANTAGE_API_KEY=L3UFYZPJ5YTC2ETK
OPENFIGI_API_KEY=

# Google Cloud Platform (optional for staging)
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# Redis (optional for staging)
REDIS_URL=redis://localhost:6379/0

# Market Data Settings
ENABLE_MOCK_DATA=false
